#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_DIR"
exec "$APP_DIR/venv/bin/gunicorn" \
  --workers 2 --threads 4 --timeout 30 \
  --bind "${DASHBOARD_HOST:-127.0.0.1}:${DASHBOARD_PORT:-8080}" \
  "dashboard.app:create_app()"
