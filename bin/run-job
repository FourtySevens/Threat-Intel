#!/usr/bin/env bash
# Cron wrapper. It refuses concurrent executions of the same source job.
set -Eeuo pipefail

readonly APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ENV_FILE="/etc/threat-intel/threat-intel.env"
readonly LOG_DIR="/var/log/threat-intel"
readonly LOCK_DIR="/var/lock/threat-intel"

if [[ $# -ne 1 ]]; then
  echo "usage: $0 {cisa-kev|nvd|krebs|rss}" >&2
  exit 64
fi

case "$1" in
  cisa-kev|nvd|krebs|rss) ;;
  *) echo "unknown job: $1" >&2; exit 64 ;;
esac

if [[ ! -r "$ENV_FILE" ]]; then
  echo "missing readable environment file: $ENV_FILE" >&2
  exit 78
fi

umask 027
mkdir -p "$LOG_DIR" "$LOCK_DIR"
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

exec 9>"$LOCK_DIR/$1.lock"
if ! flock -n 9; then
  echo "$(date --iso-8601=seconds) $1 skipped: an earlier run holds the lock" >> "$LOG_DIR/$1.log"
  exit 0
fi

cd "$APP_DIR"
exec "$APP_DIR/venv/bin/python" -m scraper.jobs "$1" >> "$LOG_DIR/$1.log" 2>&1
