# Copy to /etc/threat-intel/threat-intel.env and set mode 0600.
# URL-encode reserved characters in the password.
DATABASE_URL=postgresql://ti_user:change-me@127.0.0.1:5432/threatintel

# Leave empty when using NVD's unauthenticated API allowance. An API key permits
# a higher request rate; the job still applies a conservative delay.
NVD_API_KEY=

# First NVD run only: how far back to fetch if no successful checkpoint exists.
NVD_INITIAL_LOOKBACK_DAYS=7
# Re-fetch a small overlap to prevent gaps at a cron boundary.
NVD_OVERLAP_MINUTES=15
NVD_REQUEST_DELAY_SECONDS=6.5

HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# json is intended for cron-managed log files; set plain for local development.
LOG_FORMAT=json

# The dashboard binds to loopback by default. Publish it only through an
# authenticated reverse proxy; do not bind directly to the internet.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Optional read-only connection string; DATABASE_URL is used when omitted.
DASHBOARD_DATABASE_URL=
