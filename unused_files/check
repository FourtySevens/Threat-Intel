def get_or_create_cve_stub(cve_id: str):
    cve = find_cve_by_cve_id(cve_id)
    if cve:
        return cve

    return insert_cve({
        "cve_id": cve_id,
        "description": "KEV-listed CVE (details pending)",
        "cvss_score": None,
        "severity": "UNKNOWN",
        "source": "cisa",
    })

