def upsert_kev_status(
    cve_id: int,
    date_added,
    due_date,
    required_action,
    exploited: bool
):

    query = """
    INSERT INTO cve_kev (
        cve_id, exploited, date_added, due_date,
        required_action, updated_at
    )
    VALUES(%s, %s, %s, %s, %s, NOW())
    ON CONFLICT (cve_id)
    DO UPDATE SET
        exploited = EXCLUDED.exploited,
        date_dadded = EXCLUDED.date_added,
        due_date = EXCLUDED.due_date,
        required_action = EXCLUDED.required_action,
        updated_at = NOW();
    """

    execute(query)
