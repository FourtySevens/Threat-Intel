import requests

CISA_KEV_URL = (
    "https://www.cisa.gov/sites/default/files/feeds/"
    "known_exploited_vulnerabilities.json"
)

def fetch_kev_feed():
    resp = requests.get(CISA_KEV_URL, timout=15)
    resp.raise_for_status()
    return resp.json()["vulnerabilities"]

/enrichment/kev_enricher.py

from feeds.cisa_kev import fetch_kev_feed
from enrichment.kev_normalizer import normalize_kev
from storage.cve_repository import get_or_create_cve_stub
from storage.kev_repository import upsert_kev_status

def enrich_with_kev():
    entries = fetch_kev_feed()

    for entry in entries:
        kev = normalize_kev(entry)

        cve = get_or_create_cve_stub(kev["cve_id"])

        upsert_kev_status(
            cve_id=cve["id"],
            date_added=kev["date_added"],
            due_date=kev["due_date"],
            required_action=kev["required_action"],
            exploited=True
        )

